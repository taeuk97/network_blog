---
import '@/styles/prose.css';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleRow from '@/components/ArticleRow.astro';
import { mdxComponents } from '@/components/mdx';
import { getAllPosts, getProjects, formatDate, isoDate } from '@/lib/content';
import { url } from '@/lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({ params: { slug: project.id }, props: { project, index: i + 1 } }));
}

const { project, index } = Astro.props as { project: CollectionEntry<'projects'>; index: number };
const d = project.data;
const { Content, headings } = await render(project);

// Related entries: listed explicitly in front matter, or posts that declare `project: <id>`
const posts = await getAllPosts();
const pick = (collection: string, ids: string[]) =>
  posts.filter((p) => p.collection === collection && (ids.includes(p.id) || p.project === project.id));
const groups = [
  { title: 'Related blog posts', items: pick('blog', d.relatedBlog) },
  { title: 'Related labs', items: pick('labs', d.relatedLabs) },
  { title: 'Related measurements', items: pick('measurements', d.relatedMeasurements) },
];

/** Standard sections every project page grows into (see templates/project-template.md). */
const outline = [
  'Project Overview',
  'Motivation',
  'System Architecture',
  'Technologies',
  'Implementation',
  'Experimental Evaluation',
  'Results',
];
const present = new Set(headings.map((h) => h.text.toLowerCase()));
---

<BaseLayout title={d.title} description={d.description}>
  <article class="project">
    <header class="p-header shell">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href={url('/projects/')}>Engineering Projects</a>
        <span aria-hidden="true">/</span>
        <span>Project {String(index).padStart(2, '0')}</span>
      </nav>
      <div class="p-title">
        <h1>{d.title}</h1>
        <span class="status" data-status={d.status}>{d.status}</span>
      </div>
      <p class="p-desc">{d.description}</p>
    </header>

    <div class="p-body shell">
      <div class="p-main">
        <div class="prose">
          <Content components={mdxComponents} />
        </div>

        {
          groups.map((g) => (
            <section class="p-related" aria-label={g.title}>
              <h2 class="block-title">{g.title}</h2>
              {g.items.length > 0 ? (
                <div class="article-list">
                  {g.items.map((p) => (
                    <ArticleRow item={p} showTags={false} />
                  ))}
                </div>
              ) : (
                <p class="none mono">None yet</p>
              )}
            </section>
          ))
        }
      </div>

      <aside class="p-aside" aria-label="Project facts">
        <dl class="p-facts">
          <div>
            <dt class="mono">Status</dt>
            <dd><span class="status" data-status={d.status}>{d.status}</span></dd>
          </div>
          {
            d.keywords.length > 0 && (
              <div>
                <dt class="mono">Technologies</dt>
                <dd>
                  <ul class="tags">
                    {d.keywords.map((k) => (
                      <li class="tag tag-mono">{k}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
          <div>
            <dt class="mono">Repository</dt>
            <dd>
              {
                d.repo ? (
                  <a class="text-link" href={d.repo} target="_blank" rel="noopener noreferrer">
                    {d.repo.replace(/^https?:\/\/(www\.)?github\.com\//, '')} <span class="arrow">↗</span>
                  </a>
                ) : (
                  <span class="none">Not published yet</span>
                )
              }
            </dd>
          </div>
          {
            d.started && (
              <div>
                <dt class="mono">Started</dt>
                <dd>
                  <time datetime={isoDate(d.started)}>{formatDate(d.started)}</time>
                </dd>
              </div>
            )
          }
          {
            d.updated && (
              <div>
                <dt class="mono">Last updated</dt>
                <dd>
                  <time datetime={isoDate(d.updated)}>{formatDate(d.updated)}</time>
                </dd>
              </div>
            )
          }
          <div>
            <dt class="mono">Documentation</dt>
            <dd>
              <ul class="outline">
                {
                  outline.map((s) => (
                    <li class:list={{ done: present.has(s.toLowerCase()) }}>
                      <span aria-hidden="true">{present.has(s.toLowerCase()) ? '●' : '○'}</span>
                      {s}
                      <span class="sr-only">{present.has(s.toLowerCase()) ? '(written)' : '(not written yet)'}</span>
                    </li>
                  ))
                }
              </ul>
            </dd>
          </div>
        </dl>
      </aside>
    </div>

    <footer class="shell p-footer">
      <a class="text-link" href={url('/projects/')}><span class="arrow" aria-hidden="true">←</span> All projects</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .p-header {
    padding: 64px 0 48px;
  }

  .crumbs {
    display: flex;
    gap: 10px;
    color: var(--subtle);
    font-size: 0.75rem;
  }

  .crumbs a {
    color: var(--accent);
    text-decoration: none;
  }

  .p-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 20px;
  }

  h1 {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .p-desc {
    max-width: 720px;
    margin-top: 20px;
    color: var(--muted);
    font-size: 1.125rem;
  }

  .p-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--border);
  }

  .p-related {
    margin-top: 56px;
  }

  .p-related .block-title {
    font-size: 1.125rem;
    margin-bottom: 14px;
  }

  .none {
    color: var(--subtle);
    font-size: 0.8125rem;
  }

  .p-aside {
    align-self: start;
    position: sticky;
    top: calc(var(--header-height) + 32px);
  }

  .p-facts {
    display: grid;
    gap: 22px;
    margin: 0;
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(16, 22, 38, 0.82);
  }

  .p-facts dt {
    margin-bottom: 8px;
    color: var(--subtle);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .p-facts dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  .p-facts .tags {
    gap: 6px;
  }

  .outline {
    display: grid;
    gap: 4px;
    padding: 0;
    list-style: none;
    color: var(--subtle);
    font-size: 0.875rem;
  }

  .outline li span[aria-hidden] {
    display: inline-block;
    width: 16px;
    font-size: 0.625rem;
    vertical-align: 1px;
  }

  .outline li.done {
    color: var(--text);
  }

  .outline li.done span[aria-hidden] {
    color: var(--accent);
  }

  .p-footer {
    padding: 72px 0 96px;
  }

  @media (max-width: 960px) {
    .p-body {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .p-aside {
      position: static;
      order: -1;
    }
  }

  @media (max-width: 520px) {
    .p-header {
      padding: 44px 0 36px;
    }
  }
</style>
