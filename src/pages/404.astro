---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { navigation } from '@/config/site';
import { url } from '@/lib/url';
---

<BaseLayout title="Page not found" noindex>
  <section class="nf shell">
    <p class="mono probe">
      <span>$ traceroute {'<this page>'}</span>
      <span> 1  * * *</span>
      <span> 2  * * *  destination unreachable</span>
    </p>
    <p class="eyebrow"><span class="num">404 /</span>Not found</p>
    <h1>This route doesn’t <em>exist.</em></h1>
    <p class="text">The page may have moved, or the link may be incorrect. Try one of these instead:</p>
    <div class="links">
      <a class="button button-primary" href={url('/')}>Home <span class="arrow" aria-hidden="true">↗</span></a>
      {
        navigation.map((n) => (
          <a class="button button-secondary button-sm" href={url(n.href)}>
            {n.label}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    padding: 96px 0 120px;
  }

  .probe {
    display: grid;
    margin-bottom: 40px;
    color: var(--subtle);
    font-size: 0.8125rem;
    white-space: pre;
  }

  h1 {
    margin-top: 16px;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.04em;
  }

  h1 em {
    font-style: normal;
    color: var(--primary);
  }

  .text {
    margin-top: 20px;
    color: var(--muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 32px;
  }
</style>
