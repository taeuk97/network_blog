---
import type { Category } from '@/config/taxonomy';
import type { PostItem } from '@/lib/content';

interface Props {
  categories: readonly Category[];
  items: PostItem[];
  /** id of the list section to jump to */
  target?: string;
}
const { categories, items, target = 'entries' } = Astro.props;
const count = (name: string) => items.filter((i) => i.category === name).length;
---

<ul class="cat-grid">
  {
    categories.map((c, i) => {
      const n = count(c.name);
      return (
        <li>
          <a class="card card-link cat" href={`?category=${c.slug}#${target}`} data-cat-link={c.name}>
            <span class="cat-head">
              <span class="cat-num mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="cat-count mono">{n === 0 ? '—' : `${n} ${n === 1 ? 'entry' : 'entries'}`}</span>
            </span>
            <span class="cat-name">{c.name}</span>
            {c.description && <span class="cat-desc">{c.description}</span>}
            {c.topics && (
              <span class="cat-topics">
                {c.topics.map((t) => (
                  <span class="tag tag-mono">{t}</span>
                ))}
              </span>
            )}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .cat {
    display: flex;
    flex-direction: column;
    gap: 10px;
    height: 100%;
    padding: 24px;
    text-decoration: none;
  }

  .cat:hover {
    transform: translateY(-2px);
  }

  .cat-head {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
  }

  .cat-num {
    color: var(--primary);
  }

  .cat-count {
    color: var(--subtle);
  }

  .cat-name {
    margin-top: 4px;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .cat:hover .cat-name {
    color: var(--accent);
  }

  .cat-desc {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .cat-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 4px;
  }

  @media (max-width: 520px) {
    .cat-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // When JS is on, filter in place instead of reloading the page.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-cat-link]')) {
    link.addEventListener('click', (e) => {
      const btn = document.querySelector<HTMLButtonElement>(`[data-index] [data-category="${CSS.escape(link.dataset.catLink ?? '')}"]`);
      if (!btn) return;
      e.preventDefault();
      btn.click();
      document.getElementById(link.hash.slice(1))?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }
</script>
