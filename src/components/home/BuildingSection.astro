---
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import EmptyState from '@/components/EmptyState.astro';
import MeasurementConcept from './MeasurementConcept.astro';
import { getProjects } from '@/lib/content';
import { url } from '@/lib/url';

const projects = await getProjects();
const featured = projects.find((p) => p.data.featured) ?? projects[0];
const rest = projects.filter((p) => p !== featured).slice(0, 2);
const featuredIndex = featured ? projects.indexOf(featured) + 1 : 1;
---

<section class="section" id="build" aria-labelledby="build-title">
  <div class="shell">
    <div class="heading-row" data-reveal>
      <SectionHeading num="02" label="What I’m Building" title="Featured *Engineering Work*" id="build-title" />
      <a class="text-link" href={url('/projects/')}>All projects <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    {
      featured ? (
        <>
          <article class="featured" data-reveal>
            <div class="featured-copy">
              <div class="fc-top">
                <p class="eyebrow">
                  <span class="num">Project {String(featuredIndex).padStart(2, '0')}</span>Featured
                </p>
                <span class="status" data-status={featured.data.status}>
                  {featured.data.status}
                </span>
              </div>
              <h3>{featured.data.title}</h3>
              <p class="fc-desc">{featured.data.description}</p>
              <ul class="tags" aria-label="Keywords">
                {featured.data.keywords.map((k) => (
                  <li class="tag tag-mono">{k}</li>
                ))}
              </ul>
              <a class="button button-primary" href={url(`/projects/${featured.id}/`)}>
                View project <span class="arrow" aria-hidden="true">↗</span>
              </a>
            </div>
            <a class="featured-visual" href={url(`/projects/${featured.id}/`)} aria-label={`${featured.data.title} — project page`}>
              {featured.id === 'internet-measurement-platform' ? (
                <MeasurementConcept />
              ) : (
                <div class="visual-placeholder mono">/projects/{featured.id}</div>
              )}
              <span class="fv-caption">
                <span>{featured.id === 'internet-measurement-platform' ? 'Concept diagram · no measured data' : featured.data.status}</span>
                <span>Read more →</span>
              </span>
            </a>
          </article>

          {rest.length > 0 && (
            <div class="project-grid">
              {rest.map((p, i) => (
                <div data-reveal style={`--reveal-delay:${i * 80}ms`}>
                  <ProjectCard project={p} index={projects.indexOf(p) + 1} />
                </div>
              ))}
            </div>
          )}
        </>
      ) : (
        <EmptyState command="ls projects/" title="No projects yet" text="Projects will appear here once they are added." />
      )
    }
  </div>
</section>

<style>
  .featured {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.25fr);
    overflow: hidden;
    border: 1px solid rgba(161, 147, 255, 0.32);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(124, 111, 220, 0.13), rgba(16, 22, 38, 0.94) 60%);
  }

  .featured-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 40px;
  }

  .fc-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 16px;
    width: 100%;
  }

  .fc-top .eyebrow {
    white-space: nowrap;
  }

  .featured-copy h3 {
    margin: 20px 0 16px;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
  }

  .fc-desc {
    color: var(--muted);
  }

  .featured-copy .tags {
    margin: 24px 0 32px;
  }

  .featured-copy .button {
    margin-top: auto;
  }

  .featured-visual {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    min-width: 0;
    padding: 36px 32px 28px;
    border-left: 1px solid var(--border);
    background: rgba(5, 10, 18, 0.62);
    text-decoration: none;
  }

  .fv-caption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    color: var(--subtle);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .fv-caption span:last-child {
    color: var(--accent);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .featured-visual:hover .fv-caption span:last-child {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .visual-placeholder {
    display: grid;
    place-items: center;
    min-height: 220px;
    color: var(--subtle);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius);
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 20px;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured-visual {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .project-grid {
      grid-template-columns: 1fr;
    }

    .featured-copy {
      padding: 28px 24px;
    }

    .featured-visual {
      padding: 24px 18px 20px;
    }

    .fv-caption {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
