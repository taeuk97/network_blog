---
import Icon from '@/components/Icon.astro';
import { contactLinks } from '@/lib/links';

const contacts = contactLinks();
---

<section class="section connect" id="connect" aria-labelledby="connect-title">
  <div class="shell connect-inner" data-reveal>
    <p class="eyebrow"><span class="num">04 /</span>Let’s Connect</p>
    <h2 id="connect-title">Always curious.<br /><em>Always learning.</em></h2>
    <p class="connect-text">
      If you’re working on networks, Internet measurement or satellite connectivity — or you simply want to talk about how
      the Internet works — I’d be glad to hear from you.
    </p>
    <div class="connect-actions">
      {
        contacts.map((c) => (
          <a
            class="button button-ghost"
            href={c.href}
            {...(c.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <Icon name={c.icon} size={19} />
            {c.label}
            <span class="arrow" aria-hidden="true">↗</span>
            {c.external && <span class="sr-only">(opens in a new tab)</span>}
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .connect {
    text-align: center;
    background: radial-gradient(ellipse 70% 80% at 50% 100%, rgba(124, 111, 220, 0.13), transparent 70%);
  }

  .connect-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  h2 {
    margin-top: 18px;
    font-size: clamp(2.25rem, 5vw, 4rem);
    letter-spacing: -0.04em;
  }

  h2 em {
    font-style: normal;
    color: var(--primary);
  }

  .connect-text {
    max-width: 600px;
    margin-top: 24px;
    color: var(--muted);
  }

  .connect-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin-top: 40px;
  }

  @media (max-width: 520px) {
    .connect-actions {
      flex-direction: column;
      width: 100%;
      align-items: center;
    }

    .connect-actions .button {
      width: min(100%, 300px);
    }
  }
</style>
