---
/**
 * Conceptual diagram for the Internet Measurement Platform:
 * one vantage point, two access paths (satellite / terrestrial), common targets.
 * Illustrative only — it shows no measured data.
 */
---

<svg class="concept" viewBox="0 0 520 300" role="img" aria-labelledby="concept-title concept-desc">
  <title id="concept-title">Measurement concept</title>
  <desc id="concept-desc">
    A vantage point at KAIST reaches the same Internet targets (RIPE Atlas and AWS) over two access paths: Starlink via a LEO
    satellite and ground station, and a terrestrial ISP.
  </desc>

  <!-- paths -->
  <path class="link link-sat" d="M64 150 L166 96 L260 48 L354 96 L440 150" />
  <path class="link link-ter" d="M64 150 L260 220 L440 150" />
  <path class="flow flow-sat" d="M64 150 L166 96 L260 48 L354 96 L440 150" />
  <path class="flow flow-ter" d="M64 150 L260 220 L440 150" />

  <!-- nodes -->
  <g class="node node-main"><circle cx="64" cy="150" r="13" class="ring" /><circle cx="64" cy="150" r="5" /></g>
  <g class="node node-sat"><circle cx="166" cy="96" r="4.5" /></g>
  <g class="node node-sat"><circle cx="260" cy="48" r="10" class="ring" /><circle cx="260" cy="48" r="4.5" /></g>
  <g class="node node-sat"><circle cx="354" cy="96" r="4.5" /></g>
  <g class="node node-ter"><circle cx="260" cy="220" r="4.5" /></g>
  <g class="node node-main"><circle cx="440" cy="150" r="13" class="ring" /><circle cx="440" cy="150" r="5" /></g>

  <!-- labels -->
  <text x="64" y="186" text-anchor="middle" class="label">Vantage point</text>
  <text x="64" y="202" text-anchor="middle" class="sub">KAIST</text>

  <text x="150" y="68" text-anchor="end" class="label">Starlink</text>
  <text x="150" y="84" text-anchor="end" class="sub">terminal</text>
  <text x="260" y="22" text-anchor="middle" class="label">LEO satellite</text>
  <text x="370" y="68" class="label">Ground station</text>
  <text x="370" y="84" class="sub">gateway</text>

  <text x="260" y="246" text-anchor="middle" class="label">Terrestrial ISP</text>

  <text x="440" y="186" text-anchor="middle" class="label">Targets</text>
  <text x="440" y="202" text-anchor="middle" class="sub">RIPE Atlas · AWS</text>

  <!-- legend -->
  <g class="legend" transform="translate(24 276)">
    <line x1="0" y1="0" x2="22" y2="0" class="link-sat legend-line" />
    <text x="30" y="4" class="sub">satellite path</text>
    <line x1="132" y1="0" x2="154" y2="0" class="link-ter legend-line" />
    <text x="162" y="4" class="sub">terrestrial path</text>
  </g>
</svg>

<style>
  .concept {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .link {
    fill: none;
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .link-sat {
    stroke: rgba(161, 147, 255, 0.45);
  }

  .link-ter {
    stroke: rgba(97, 197, 255, 0.4);
  }

  .flow {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 2 18;
    animation: flow 2.8s linear infinite;
  }

  .flow-sat {
    stroke: var(--primary);
  }

  .flow-ter {
    stroke: var(--accent);
    animation-duration: 2.2s;
  }

  @keyframes flow {
    to {
      stroke-dashoffset: -200;
    }
  }

  .node circle {
    fill: var(--bg);
    stroke-width: 1.6;
  }

  .node-main circle {
    stroke: var(--text);
  }

  .node-main circle:not(.ring) {
    fill: var(--text);
  }

  .node-sat circle {
    stroke: var(--primary);
  }

  .node-sat circle:not(.ring) {
    fill: var(--primary);
  }

  .node-ter circle {
    stroke: var(--accent);
    fill: var(--accent);
  }

  .ring {
    fill: none !important;
    opacity: 0.45;
  }

  .label {
    fill: var(--text);
    font: 600 12px var(--font-body);
  }

  .sub {
    fill: var(--muted);
    font: 400 11px var(--font-mono);
  }

  .legend-line {
    stroke-width: 2;
  }

  /* Keep labels legible when the diagram is scaled down on phones */
  @media (max-width: 560px) {
    .label {
      font-size: 17px;
    }

    .sub {
      font-size: 15px;
    }

    .legend {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow {
      display: none;
    }
  }
</style>
