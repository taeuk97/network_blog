---
import SectionHeading from '@/components/SectionHeading.astro';
import { url } from '@/lib/url';

const areas = [
  {
    title: 'IP & Service Provider Networks',
    text: 'How carrier networks route, scale and stay up — the protocols that move traffic between and across ISPs.',
    topics: ['BGP', 'OSPF', 'IS-IS', 'MPLS', 'Routing & Switching'],
  },
  {
    title: 'Internet Measurement',
    text: 'Observing the Internet as it actually behaves — paths, delays and losses measured rather than assumed.',
    topics: ['Starlink', 'RIPE Atlas', 'Internet Performance', 'Network Topology', 'Latency Analysis'],
  },
  {
    title: 'Network Systems & Infrastructure',
    text: 'The hosts, containers and cloud resources that networks run on and connect together.',
    topics: ['Linux', 'Docker', 'Cloud Computing', 'AWS', 'Network Infrastructure'],
  },
  {
    title: 'Network Automation',
    text: 'Turning repetitive operations, monitoring and troubleshooting into reliable, repeatable code.',
    topics: ['Python', 'Network Monitoring', 'Ansible', 'Network Troubleshooting'],
  },
];
---

<section class="section" id="explore" aria-labelledby="explore-title">
  <div class="shell">
    <div data-reveal>
      <SectionHeading num="01" label="What I Explore" title="From fundamentals to *real networks.*" id="explore-title" />
    </div>

    <div class="explore-layout">
      <div class="explore-copy" data-reveal>
        <p class="lead">
          I’m interested in how networks work end to end — from a single packet on a link to routing between autonomous
          systems and the performance users actually experience.
        </p>
        <p>
          The areas on the right are what I’m currently studying and exploring, not a list of mastered skills. Each one is
          approached the same way: learn the theory, build it in a lab, measure it on real networks, and write down what I
          understood.
        </p>
        <a class="text-link" href={url('/about/')}>More about me <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <ol class="areas">
        {
          areas.map((area, i) => (
            <li class="area" data-reveal style={`--reveal-delay:${i * 70}ms`}>
              <span class="area-num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{area.title}</h3>
                <p>{area.text}</p>
                <ul class="tags" aria-label={`${area.title} topics`}>
                  {area.topics.map((t) => (
                    <li class="tag tag-mono">{t}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .explore-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 64px;
    align-items: start;
  }

  .explore-copy {
    display: grid;
    gap: 20px;
    justify-items: start;
    color: var(--muted);
  }

  .explore-copy .lead {
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.7;
  }

  .explore-copy .text-link {
    margin-top: 8px;
  }

  .areas {
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .area {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 12px;
    padding: 24px 0;
    border-bottom: 1px solid var(--border);
  }

  .area-num {
    padding-top: 3px;
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .area h3 {
    font-size: 1.25rem;
    letter-spacing: -0.01em;
  }

  .area p {
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .area .tags {
    margin-top: 14px;
    gap: 6px;
  }

  @media (max-width: 900px) {
    .explore-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
