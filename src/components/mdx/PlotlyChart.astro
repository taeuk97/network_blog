---
/**
 * Interactive Plotly chart loaded from a JSON figure file.
 *
 *   <PlotlyChart src="/datasets/2026-11-starlink/rtt.json" title="RTT over time" caption="..." />
 *
 * The JSON file holds a Plotly figure: { "data": [...], "layout": {...} }
 * (e.g. exported with `fig.write_json(...)` in Python). Site colours and
 * fonts are applied on top of the figure's own layout.
 * Plotly (~1 MB) is downloaded only when a chart scrolls into view.
 */
import { url } from '@/lib/url';

interface Props {
  src: string;
  title?: string;
  caption?: string;
  height?: number;
}
const { src, title, caption, height = 420 } = Astro.props;
---

<figure class="plot">
  {title && <p class="plot-title">{title}</p>}
  <div class="plot-canvas" data-plotly-src={url(src)} style={`height:${height}px`} role="img" aria-label={title ?? 'Interactive chart'}>
    <p class="plot-status mono">Loading chart…</p>
  </div>
  <figcaption>
    {caption && <span>{caption}</span>}
    <a class="mono" href={url(src)} download>figure data ↓</a>
  </figcaption>
  <noscript><p class="plot-status mono">This chart needs JavaScript. The underlying data can be downloaded above.</p></noscript>
</figure>

<style>
  .plot {
    margin: 2em 0;
    padding: 20px 20px 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
  }

  .plot-title {
    margin-bottom: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--text);
  }

  .plot-canvas {
    position: relative;
    width: 100%;
  }

  .plot-status {
    display: grid;
    place-items: center;
    height: 100%;
    color: var(--subtle);
    font-size: 0.8125rem;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-top: 10px;
    color: var(--subtle);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  figcaption a {
    flex-shrink: 0;
    margin-left: auto;
    font-size: 0.75rem;
  }
</style>

<script>
  const charts = document.querySelectorAll<HTMLElement>('[data-plotly-src]');

  const siteLayout = {
    paper_bgcolor: 'rgba(0,0,0,0)',
    plot_bgcolor: 'rgba(0,0,0,0)',
    font: { family: 'Inter Variable, Inter, system-ui, sans-serif', color: '#a6b2c7', size: 12 },
    colorway: ['#61c5ff', '#a193ff', '#7fd6a8', '#f2c46d', '#ff8fa3', '#9aa7bd'],
    margin: { t: 24, r: 16, b: 48, l: 56 },
    xaxis: { gridcolor: 'rgba(157,176,216,0.12)', zerolinecolor: 'rgba(157,176,216,0.25)', linecolor: 'rgba(157,176,216,0.3)' },
    yaxis: { gridcolor: 'rgba(157,176,216,0.12)', zerolinecolor: 'rgba(157,176,216,0.25)', linecolor: 'rgba(157,176,216,0.3)' },
    legend: { bgcolor: 'rgba(0,0,0,0)', orientation: 'h', y: -0.18 },
    hoverlabel: { bgcolor: '#141b2d', bordercolor: '#a193ff', font: { color: '#e2e8f0' } },
  };

  const merge = (base: any, extra: any): any => {
    const out = { ...base };
    for (const [k, v] of Object.entries(extra ?? {})) {
      out[k] = v && typeof v === 'object' && !Array.isArray(v) && typeof base[k] === 'object' ? merge(base[k], v) : v;
    }
    return out;
  };

  const render = async (el: HTMLElement) => {
    try {
      const [{ default: Plotly }, fig] = await Promise.all([
        import('plotly.js-dist-min'),
        fetch(el.dataset.plotlySrc!).then((r) => {
          if (!r.ok) throw new Error(`HTTP ${r.status}`);
          return r.json();
        }),
      ]);
      el.innerHTML = '';
      await Plotly.newPlot(el, fig.data ?? [], merge(siteLayout, fig.layout), {
        responsive: true,
        displaylogo: false,
        modeBarButtonsToRemove: ['lasso2d', 'select2d'],
      });
    } catch (err) {
      el.innerHTML = '<p class="plot-status mono">Chart could not be loaded.</p>';
      console.warn('[plotly]', err);
    }
  };

  if (charts.length) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            io.unobserve(e.target);
            render(e.target as HTMLElement);
          }
        }
      },
      { rootMargin: '200px' },
    );
    charts.forEach((c) => io.observe(c));
  }
</script>
